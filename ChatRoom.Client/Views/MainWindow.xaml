<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ChatRoom.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ChatRoom.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChatRoom.Client"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ChatRoom.Client.Models"
    xmlns:viewmodel="using:ChatRoom.Client.ViewModels"
    Title="ChatRoomClient"
    d:DataContext="{d:DesignInstance Type=viewmodel:MainWindowViewModel}"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <converters:NickNameToColorConverter x:Key="NickNameToColorConverter" />
            <converters:NickNameToAlignmentConverter x:Key="NickNameToAlignmentConverter" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                Padding="18"
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource TitleTextBlockStyle}">聊天室</TextBlock>
                <ListView
                    x:Name="ChatListView"
                    Grid.Row="1"
                    VerticalAlignment="Stretch"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="5"
                    ItemsSource="{Binding DataContext.MessageInfoList, ElementName=ChatListView}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding DataContext.SelectedMessage, ElementName=ChatListView, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:MessageInfo">
                            <!--  解决 Window 中 x:Bind 搭配 StaticResource 导致的编译报错，将含有 Converter 的部分改用 Binding  -->
                            <Grid
                                Margin="0,0,0,12"
                                HorizontalAlignment="{Binding SenderType, Converter={StaticResource NickNameToAlignmentConverter}}"
                                RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="{Binding SenderType, Converter={StaticResource NickNameToAlignmentConverter}}"
                                    FontWeight="Bold"
                                    Foreground="{Binding SenderType, Converter={StaticResource NickNameToColorConverter}}"
                                    Text="{x:Bind SenderNickName}" />

                                <Grid
                                    Grid.Row="1"
                                    Padding="4"
                                    Background="{Binding SenderType, Converter={StaticResource NickNameToColorConverter}}"
                                    CornerRadius="3">
                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="{Binding SenderType, Converter={StaticResource NickNameToAlignmentConverter}}"
                                        Text="{x:Bind Message}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <!--  允许Item的内部内容（如StackPanel）去控制水平对齐  -->
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <Grid
                    Grid.Row="2"
                    VerticalAlignment="Bottom"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="MessageTextBox"
                        Grid.Column="0"
                        Text="{Binding DataContext.InputMessage, ElementName=MessageTextBox, Mode=TwoWay}" />
                    <Button
                        x:Name="SendButton"
                        Grid.Column="1"
                        Command="{Binding DataContext.SendMessageCommand, ElementName=SendButton}">
                        发送
                    </Button>
                </Grid>
            </Grid>

            <Grid Grid.Column="1" Padding="18">
                <Button
                    x:Name="ConnectButton"
                    VerticalAlignment="Top"
                    Command="{Binding DataContext.ConnectCommand, ElementName=ConnectButton}">
                    连接服务器
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
