<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChatRoom.Client.Views.LoginWindowPages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChatRoom.Client.Views.LoginWindowPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ChatRoom.Client.Models"
    xmlns:viewmodel="using:ChatRoom.Client.ViewModels"
    mc:Ignorable="d">

    <StackPanel
        Padding="12"
        d:DataContext="{d:DesignInstance Type=viewmodel:LoginWindowViewModel}"
        Spacing="12">

        <StackPanel.Resources>
            <Style x:Name="ErrorInfoTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
            </Style>
        </StackPanel.Resources>

        <TextBlock
            FontSize="24"
            FontWeight="Bold"
            Text="登录" />
        <TextBlock Text="账号" />
        <TextBox
            x:Name="AccountTextBox"
            PlaceholderText="请输入账号"
            Text="{Binding UserId, Mode=TwoWay}" />
        <TextBlock
            Foreground="Tomato"
            Style="{StaticResource ErrorInfoTextBlockStyle}"
            Text="{Binding UserIdValidationMessage}"
            Visibility="{Binding UserIdValidationMessage, Converter={StaticResource StringToVisibilityConverter}}" />
        <TextBlock Text="密码" />
        <TextBox
            x:Name="PasswordTextBox"
            PlaceholderText="请输入密码"
            Text="{Binding Password, Mode=TwoWay}" />
        <TextBlock
            Foreground="Tomato"
            Style="{StaticResource ErrorInfoTextBlockStyle}"
            Text="{Binding PasswordValidationMessage}"
            Visibility="{Binding PasswordValidationMessage, Converter={StaticResource StringToVisibilityConverter}}" />
        <TextBlock
            Margin="0,6,0,0"
            Foreground="Tomato"
            Style="{StaticResource ErrorInfoTextBlockStyle}"
            Text="{Binding ServerErrorMessage}"
            Visibility="{Binding ServerErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
        <Button
            HorizontalAlignment="Stretch"
            Command="{Binding LoginCommand}"
            Content="登录" />
    </StackPanel>
</Page>
