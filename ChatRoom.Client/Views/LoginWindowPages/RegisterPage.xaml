<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChatRoom.Client.Views.LoginWindowPages.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChatRoom.Client.Views.LoginWindowPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ChatRoom.Client.Models"
    xmlns:viewmodel="using:ChatRoom.Client.ViewModels"
    mc:Ignorable="d">

    <StackPanel
        Grid.Row="1"
        Padding="12"
        d:DataContext="{d:DesignInstance Type=viewmodel:LoginWindowViewModel}"
        Spacing="12">

        <StackPanel.Resources>
            <Style x:Name="ErrorInfoTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
            </Style>
        </StackPanel.Resources>

        <TextBlock
            FontSize="24"
            FontWeight="Bold"
            Text="注册" />
        <TextBlock Text="账号" />
        <TextBox
            x:Name="AccountTextBox"
            PlaceholderText="请输入账号"
            Text="{Binding UserId, Mode=TwoWay}" />
        <TextBlock
            Foreground="Tomato"
            Style="{StaticResource ErrorInfoTextBlockStyle}"
            Text="{Binding UserIdValidationMessage}"
            Visibility="{Binding UserIdValidationMessage, Converter={StaticResource StringToVisibilityConverter}}" />
        <TextBlock Text="昵称" />
        <TextBox
            x:Name="NickNameTextBox"
            PlaceholderText="请输入昵称"
            Text="{Binding NickName, Mode=TwoWay}" />
        <TextBlock
            Foreground="Tomato"
            Style="{StaticResource ErrorInfoTextBlockStyle}"
            Text="{Binding NickNameValidationMessage}"
            Visibility="{Binding NickNameValidationMessage, Converter={StaticResource StringToVisibilityConverter}}" />
        <TextBlock Text="密码" />
        <TextBox
            x:Name="PasswordTextBox"
            PlaceholderText="请输入密码"
            Text="{Binding Password, Mode=TwoWay}" />
        <TextBlock
            Foreground="Tomato"
            Style="{StaticResource ErrorInfoTextBlockStyle}"
            Text="{Binding PasswordValidationMessage}"
            Visibility="{Binding PasswordValidationMessage, Converter={StaticResource StringToVisibilityConverter}}" />
        <TextBlock Text="确认密码" />
        <TextBox
            x:Name="PasswordAgainTextBox"
            PlaceholderText="请在此输入密码"
            Text="{Binding PasswordAgain, Mode=TwoWay}" />
        <TextBlock
            Foreground="Tomato"
            Style="{StaticResource ErrorInfoTextBlockStyle}"
            Text="{Binding PasswordAgainValidationMessage}"
            Visibility="{Binding PasswordAgainValidationMessage, Converter={StaticResource StringToVisibilityConverter}}" />
        <Button
            HorizontalAlignment="Stretch"
            Command="{Binding RegisterCommand}"
            Content="注册" />
    </StackPanel>
</Page>
