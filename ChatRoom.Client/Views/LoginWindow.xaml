<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ChatRoom.Client.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChatRoom.Client.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ChatRoom.Client.Models"
    xmlns:viewmodel="using:ChatRoom.Client.ViewModels"
    Title="LoginWindow"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid d:DataContext="{d:DesignInstance Type=viewmodel:LoginWindowViewModel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Grid.Row="0" />

        <NavigationView
            x:Name="LoginNavigationView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            ItemInvoked="RootNavigation_ItemInvoked"
            PaneDisplayMode="Top"
            SelectionFollowsFocus="Enabled">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="LoginPageItem"
                    Content="登录"
                    Tag="LoginPage" />
                <NavigationViewItem
                    x:Name="RegisterPageItem"
                    Content="注册"
                    Tag="RegisterPage" />
            </NavigationView.MenuItems>
            <Frame x:Name="contentFrame" />
        </NavigationView>
    </Grid>
</Window>
